# Log format and verbosity.
# LOG_ENV: development | production
LOG_ENV=development
# LOG_LEVEL: debug | info | warn | error
LOG_LEVEL=info

# Feed size. Range 1..20.
FEED_SIZE=20

# Google OAuth desktop client JSON. Required by `ytfeed auth login`.
# See docs/30-implementation/oauth-setup.md.
GOOGLE_OAUTH_CLIENT_FILE=

# YouTube Data API key. Optional. Used by discovery when OAuth is not available.
YOUTUBE_API_KEY=

# Any OpenAI-compatible /v1/chat/completions endpoint.
LLM_BASE_URL=http://localhost:11434/v1
# Default chosen by spike S-01 on the Intel target.
LLM_MODEL=lfm2.5-1.2b-instruct
LLM_API_KEY=not-needed
# Schema-constrained JSON output.
LLM_JSON_MODE=true

# Local data directory.
YTFEED_DATA_DIR=./data

# YouTube region for search and trending.
YOUTUBE_REGION=US

# Analysis concurrency. Range 1..8.
ANALYSIS_CONCURRENCY=2
# Stage transcripts between fetch and analysis. true | false.
TRANSCRIPT_STAGING=true
# Staging lifetime. Duration like 24h.
TRANSCRIPT_STAGING_TTL=24h
# Maximum transcript size in bytes. 8 MiB.
TRANSCRIPT_MAX_BYTES=8388608
# yt-dlp binary.
YTDLP_BIN=yt-dlp
# LLM request timeout. Duration like 60s.
LLM_TIMEOUT=60s
# Player command for saved videos. Empty uses the OS default.
PLAYER_CMD=
# Default refresh source for `ytfeed feed --refresh`.
# One of: mixed, trending, graph, fresh, keywords. Default: mixed.
FEED_REFRESH_SOURCE=mixed
# Maximum subscribed channels read for graph discovery. Range 1-50. Default 20.
FEED_GRAPH_CHANNEL_LIMIT=20
# Maximum related channels from search or trending results. Range 0-50. Default 10.
FEED_GRAPH_RELATED_LIMIT=10
